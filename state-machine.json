{
  "Comment": "Resize an image from the originals bucket and check the result.",
  "QueryLanguage": "JSONPath",
  "StartAt": "Resize Image",
  "States": {
    "Resize Image": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ca-central-1:244933794857:function:rica-capstone-resize-image",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "Was Resize Successful?",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Resize Failed"
        }
      ]
    },
    "Was Resize Successful?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.success",
          "BooleanEquals": true,
          "Next": "Resize Succeeded"
        }
      ],
      "Default": "Resize Failed"
    },
    "Resize Succeeded": {
      "Type": "Succeed"
    },
    "Resize Failed": {
      "Type": "Fail",
      "Error": "ImageResizeFailed"
    }
  }
}
